#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG=/mnt/mmcblk2p4/cellbridge/run-staging.sh

start_service() {
	[ -x "$PROG" ] || {
		echo "missing executable: $PROG" >&2
		return 1
	}

	procd_open_instance
	procd_set_param command "$PROG"
	# Keep recovering after a temporarily absent USB module. Retry 0 is unlimited.
	procd_set_param respawn 3600 15 0
	procd_set_param limits core="0"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 10
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger cellbridge
}
